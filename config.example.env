# LinkedIn Recruiter Multi-Model Sourcing Pipeline — Configuration
# Copy this to .env and fill in your keys.

# --- API Keys ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME
# GOOGLE_API_KEY=REPLACE_ME

# --- Model Selection ---
# Which provider for cheap extraction calls: "openai" or "google"
CHEAP_MODEL_PROVIDER=openai
# Specific model names (defaults shown)
CHEAP_MODEL_NAME=gpt-4o-mini
OPUS_MODEL_NAME=claude-opus-4-6

# --- Browser ---
# CDP endpoint for the OpenClaw managed browser (or any Chromium with remote debugging)
CDP_URL=http://127.0.0.1:18800

# --- Behavior ---
# Max pages to paginate per search string (0 = unlimited)
MAX_PAGES_PER_STRING=0
# Seconds to wait between page navigations (politeness delay)
PAGE_DELAY_SECONDS=3
# Seconds to wait between profile loads
PROFILE_DELAY_SECONDS=2
